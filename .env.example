# GEMINI_API_KEY: Optional server-side key if AI project scoping assistant is enabled later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: REQUIRED to use the Admin Console. Checked on the server only.
# When empty, the entire /api/admin/* API is disabled (fails closed).
# Use a long, random passphrase (16+ characters).
ADMIN_PASSCODE=""

# SESSION_SECRET: Random string used to sign admin/student session tokens
# (e.g. `openssl rand -hex 32`). If empty, a random secret is generated at each
# server start, so everyone is signed out whenever the server restarts.
SESSION_SECRET=""

# SMTP_WEBHOOK_URL: Optional webhook URL (e.g., Resend, Formspree, Make, or Slack webhook)
# to forward project enquiries and career registrations in real time.
SMTP_WEBHOOK_URL=""

# COMPANY_WHATSAPP: Optional verified company WhatsApp number in international format (e.g., 919876543210).
# The WhatsApp contact button is only activated when a real number is provided here or in Admin Settings.
COMPANY_WHATSAPP=""

# COMPANY_EMAIL: Primary contact email address displayed on the site.
COMPANY_EMAIL="contact@lovanstrix.tech"
