# ============================================================================
# LOVANSTRIX — FULL-STACK MERN ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in values for your local or production deployment.
# ============================================================================

# Server Runtime Configuration
NODE_ENV="development"
PORT="3000"

# MongoDB Connection (MongoDB Atlas or Local MongoDB Instance)
# Example Local: mongodb://127.0.0.1:27017/lovanstrix
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lovanstrix?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="lovanstrix"

# Admin Console Security (REQUIRED for Admin Console access; minimum 12 characters)
ADMIN_PASSCODE=""

# Optional Transactional Email Notifications (Nodemailer SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="contact@lovanstrix.com"

# Optional AI Studio / Platform Variables
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
